{% assign titlecolum_fv4_1 = section.titlecolum_fv4_1 | default: titlecolum_fv4_1 %}
{% assign menu_fv4_1 = section.menu_fv4_1 | default: menu_fv4_1 %}
{% assign titlecolum_fv4_2 = section.titlecolum_fv4_2 | default: titlecolum_fv4_2 %}
{% assign menu_fv4_2 = section.menu_fv4_2 | default: menu_fv4_2 %}
{% assign titlecolum_fv4_3 = section.titlecolum_fv4_3 | default: titlecolum_fv4_3 %}
{% assign menu_fv4_3 = section.menu_fv4_3 | default: menu_fv4_3 %}
{% assign titlecolum_fv4_4 = section.titlecolum_fv4_4 | default: titlecolum_fv4_4 %}
{% assign fv4_phone = section.settings.fv4_phone | default: settings.fv4_phone %}
{% assign fv4_email = section.settings.fv4_email | default: settings.fv4_email %}
{% assign fv4_address = section.settings.fv4_address | default: settings.fv4_address %}
{% assign content_colum_fv4_5_1 = section.content_colum_fv4_5_1 | default: content_colum_fv4_5_1 %}
{% assign content_colum_fv4_5 = section.content_colum_fv4_5 | default: content_colum_fv4_5 %}

{% assign enable_fv4_bottom = enable_fv4_bottom %}
{% if section.enable_fv4_bottom != nil %}
  {% assign enable_fv4_bottom = section.enable_fv4_bottom %}
{% endif %}

{% assign fv4_main_logo = section.fv4_main_logo | default: fv4_main_logo %}
{% assign fv4_main_logo_maxwidth = section.fv4_main_logo_maxwidth | default: fv4_main_logo_maxwidth %}
{% assign logo_svg4 = section.logo_svg4 | default: logo_svg4 %}
{% assign fv4_bottom_payment_img = section.fv4_bottom_payment_img | default: fv4_bottom_payment_img %}
{% assign fv4_bottom_copyright = section.fv4_bottom_copyright | default: fv4_bottom_copyright %}

{% if section.settings.select_fts == "footer_v4" %}
{% if template contains 'index' %}
<footer class="footer_v4" style="background-color : {{ section.settings.ft_home_bg_footer }}">

  <div class="top-footer">
    <div class="container container-v1 ">    
      <div class="row">
        <div class="col-lg-3 col-sm-6">
          <div class="info_footer">
            <div class="title_footer">          
              <h4 class="mb-0 title_border">{{ titlecolum_fv4_1 }}</h4>         
            </div>
            <ul class="list-unstyled mb-0">
              {% for link in linklists[menu_fv4_1].links %}
              <li><a href="{{ link.url }}" title="{{ link.title }}">{{link.title }}</a></li>
              {% endfor %}
            </ul>        
          </div>
        </div>
        <div class="col-lg-3 col-sm-6">
          <div class="info_footer">
            <div class="title_footer">          
              <h4 class="mb-0 title_border">{{ titlecolum_fv4_2 }}</h4>         
            </div>
            <ul class="list-unstyled mb-0">
              {% for link in linklists[menu_fv4_2].links %}
              <li><a href="{{ link.url }}" title="{{ link.title }}">{{link.title }}</a></li>
              {% endfor %}
            </ul>        
          </div>
        </div>
        <div class="col-lg-3 col-sm-6">
          <div class="info_footer info_contact">
            <div class="title_footer ">          
              <h4 class="mb-0 title_border">{{ titlecolum_fv4_3 }}</h4>         
            </div>
            <ul class="list-unstyled mb-0">
              {% for link in linklists[menu_fv4_3].links %}
              <li><a href="{{ link.url }}" title="{{ link.title }}">{{link.title }}</a></li>
              {% endfor %}
            </ul>        
          </div>
        </div>
        <div class="col-lg-3 col-sm-6">
          <div class="info_footer info_contact">
            <div class="title_footer ">          
              <h4 class="mb-0 title_border">{{ titlecolum_fv4_4 }}</h4>         
            </div>
            {% if content_colum_fv4_5_1 != blank %}
            {{ content_colum_fv4_5_1 }}
            {% else %}
            <ul class="list-unstyled mb-0">
              {% if fv4_phone != blank %}
              <li><a href="tel:{{ fv4_phone | replace: ' ', '' }}" title="Phone: {{ fv4_phone }}"><i class="fa fa-phone "></i>{{ fv4_phone }}</a></li>
              {% endif %}

              {% if fv4_email != blank %}
              <li><a href="mailto:{{ fv4_email }}" title="Mail : {{ fv4_email }}"><i class="fa fa-envelope "></i>{{ fv4_email }}</a></li>
              {% endif %}

              {% if fv4_address != blank %}
              <li><a href="/" title="Address : {{ fv4_address }}"><i class="fa fa-location-arrow"></i>{{ fv4_address }}</a></li>
              {% endif %}
            </ul>
            {% endif %}

            <div class="mt-3">
              {{ content_colum_fv4_5 }}
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
  {% if enable_fv4_bottom %}
  <div class="copyright">
    <div class="container container-v1">
      <div class="row align-items-center">
        <div class="col-md-4 {% if settings.enable_rtl_mode %} text-md-right {% else %}text-md-left {% endif %} text-center">
          <div class="logo-footer">
            {% if logo_svg4 != blank %}
            <div class="logosvg m-auto m-md-0" style="max-width:{{ fv4_main_logo_maxwidth }}px;">
              <a class="d-block" href="{{ shop.url }}">{{ logo_svg4 }}</a>
            </div>          
            {% else %}            
            <a href="{{ shop.url }}" class="logo">
              {% if fv4_main_logo != blank %}
              <img loading="lazy" height="{{ image.height }}" src="{{ fv4_main_logo | image_url }}"  width="{{ fv4_main_logo_maxwidth }}" alt="{{ shop.name }}" class="img-fluid">
              {% else %}
              <img loading="lazy" height="{{ image.height }}" src="//via.placeholder.com/127x35" width="{{ fv4_main_logo_maxwidth }}" alt="{{ shop.name }}" class="img-fluid">
              {% endif %}
            </a>
            {% endif %}
          </div>
        </div>

        <div class="col-md-4  text-center">
          {% if fv4_bottom_payment_img != blank %}
          <img loading="lazy"  width="" height="" src="{{ fv4_bottom_payment_img | image_url }}"  alt="">
          {% else %}
          <img loading="lazy"  width="" height="" src="//via.placeholder.com/247x23"  alt="">
          {% endif %}
        </div>

        <div class="col-md-4  {% if settings.enable_rtl_mode %} text-md-left {% else %}text-md-right {% endif %} text-center">
          {% if fv4_bottom_copyright != blank %}
          <p class="text-copyright mb-0">{{ fv4_bottom_copyright }}</p>
          {% else %}
          {% if settings.enable_rtl_mode %}
          <div class="text-copyright mb-0"><p>© <a href="https://www.shopify.com/?ref=shopifycenter" rel="nofollow" target="_blank" class=""> Powered by Shopify.</a>  <a href="http://shopilaunch.com/" rel="nofollow" target="_blank" class="underline_hover link"> ShopiLaunch</a> By  <a href="http://shopilaunch.com/" rel="nofollow" target="_blank" class="underline_hover bold"> FoodicStore </a> | 2022 Copyright   </p> 
          </div>          
          {% else %}
          <div class="text-copyright mb-0"><p>© Copyright 2022 | <a href="http://shopilaunch.com/" rel="nofollow" target="_blank" class="underline_hover bold"> FoodicStore </a> By <a href="http://shopilaunch.com/" rel="nofollow" target="_blank" class="underline_hover link"> ShopiLaunch.</a><a href="https://www.shopify.com/?ref=shopifycenter" rel="nofollow" target="_blank" class=""> Powered by Shopify.</a></p> 
          </div>
          {% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}

</footer>
<style>
  .footer_v4 .top-footer .title_footer h4{
    color : {{ section.settings.ft_home_color_text }};
  }
  .footer_v4 .top-footer .info_footer ul li a{
    color : {{ section.settings.ft_home_color_text }};
  }
  .footer_v4 .top-footer .content_footer{
    color : {{ section.settings.ft_home_color_text }};
  }
</style>
{% endif %}
{% endif %}

