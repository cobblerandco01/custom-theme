{% assign enable_desc = section.settings.enable_description_tab | default: settings.enable_description_tab %}
{% assign desc_title = section.settings.destab_title | default: settings.destab_title | default: "Description" %}
{% assign desc_content = section.settings.destab_content | default: section.settings.custom_description_content | default: settings.destab_content | default: settings.custom_description_content %}

{% assign enable_add = section.settings.enable_addition_tab | default: settings.enable_addition_tab %}
{% assign add_title = section.settings.addtab_title | default: settings.addtab_title | default: "Additional Features" %}
{% assign add_content = section.settings.addtab_content | default: settings.addtab_content %}

{% assign enable_care = section.settings.enable_review_tab | default: settings.enable_review_tab %}
{% assign care_title = section.settings.reviewtab_title | default: settings.reviewtab_title | default: "Care Guide" %}
{% assign care_content = section.settings.care_guide_content | default: settings.care_guide_content %}

<div class=" tab-pd-details">
  <div class="bd-tab">
    <div class="container container-v2">
      <ul class="nav nav-tabs tab_prod">
        {% if enable_desc %}
        <li>
          <a class="underline_scale active"  data-toggle="tab" href="#des"  >{{ desc_title }}</a>
        </li>
        {% endif %}
        {% if enable_add %}
        <li >
          <a  class="underline_scale"  data-toggle="tab" href="#add"  >{{ add_title }}</a>
        </li>
        {% endif %}
        {% if enable_care %}
        <li>
          <a class="underline_scale" data-toggle="tab" href="#review" >{{ care_title }}</a>
        </li>
        {% endif %}
      </ul>
    </div>
  </div>
  <div class="tab-content container container-v4" >
    {% if enable_desc %}
    <div class="tab-pane fade show active" id="des">
      <div class="desc product-desc">
        {% if desc_content != blank %}
          {{ desc_content }}
        {% else %}
          <p>Please configure your Description content in the Theme Editor.</p>
        {% endif %}
      </div>      
    </div>
    {% endif %}
    {% if enable_add %}
    <div class="tab-pane fade tab-addition" id="add">
      {% if add_content != blank %}
      <div class="addition-content">{{ add_content }}</div>
      {% else %}
      <div class="">
        <div class="row justify-content-center">
          <div class="col-lg-8 col-md-6">
            <div class="title_content">
              <p class="more_info">More Infomation To You</p>
              <h3 class="">Things you need to know</h3>
            </div>
            <div class="row">
              <div class="col-lg-6 content1">
                <p class="info_1">We use industry standard SSL encryption to protect your details. Potentially sensitive information such as your name, address and card details are encoded so they can only be read on the secure server.</p>
                <ul class="px-0 list-unstyled">
                  <li>Safe Payments</li>
                  <li>Accept Credit Cart</li>
                  <li>Different Payment Method</li>
                  <li>Price Include VAT</li>
                  <li>Easy To Order</li>
                </ul>
              </div>
              <div class="col-lg-6 content2">
                <div class="info2">
                  <h3>Express Delivery</h3>
                  <ul class="px-0 list-unstyled">
                    <li>Europe & USA within 2-4 days</li>
                    <li>Rest of the world within 3-7 days</li>
                    <li>Selected locations</li>
                  </ul>
                </div>
                <div class="info2">
                  <h3>Need more information</h3>
                  <ul class="px-0 list-unstyled">
                    <li><a href="">Orders & Shipping</a></li>
                    <li><a href="">Returns & Refunds</a></li>
                    <li><a href="">Payments</a></li>
                    <li><a href="">Your Orders</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <img loading="lazy" width="" height="" data-src="{{ product | image_url }}" class="lazyload" alt>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
    {% endif %}
    {% if enable_care %}
    <div class="tab-pane fade mt-4" id="review">
      <div class="care-guide-content">
        {% if care_content != blank %}
          {{ care_content }}
        {% else %}
          <p>Please configure your Care Guide content in the Theme Editor.</p>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</div>  