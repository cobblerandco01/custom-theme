<!-- /sections/footer.liquid -->
{% if template contains 'index' %}
  {% if section.settings.select_fts == "footer_v1" %}
  {% include 'footer-v1' %}
  {% elsif section.settings.select_fts == "footer_v2" %}
  {% include 'footer-v2' %}
  {% elsif section.settings.select_fts == "footer_v3" %}
  {% include 'footer-v3' %}
  {% elsif section.settings.select_fts == "footer_v4" %}
  {% include 'footer-v4' %}
  {% elsif section.settings.select_fts == "footer_v5" %}
  {% include 'footer-v5' %}
  {% elsif section.settings.select_fts == "footer_v6" %}
  {% include 'footer-v6' %}
  {% elsif section.settings.select_fts == "footer_none" %}
  {% endif %}

  
{% else %}
  {% if section.settings.select_fts_all == "footer_ver1" %}
  {% include 'footer-v1' %}
  {% elsif section.settings.select_fts_all == "footer_ver2" %}
  {% include 'footer-v2' %}
  {% elsif section.settings.select_fts_all == "footer_ver3" %}
  {% include 'footer-v3' %}
  {% elsif section.settings.select_fts_all == "footer_ver4" %}
  {% include 'footer-v4' %}
  {% elsif section.settings.select_fts_all == "footer_ver5" %}
  {% include 'footer-v5' %}
  {% elsif section.settings.select_fts_all == "footer_ver6" %}
  {% include 'footer-v6' %}
  {% endif %}

{% endif %}

{% schema %}
{
  "name": "Footer",
  "class": "index-section",
  "settings": [
    {
      "type": "header",
      "content": "Footer Homepage"
    },
    {
      "type": "select",
      "id": "select_fts",
      "label": "Select Style",
      "options": [
        {
          "value": "footer_v1",
          "label": "Footer v1"
        },
        {
          "value": "footer_v2",
          "label": "Footer v2"
        },
        {
          "value": "footer_v3",
          "label": "Footer v3"
        },
        {
          "value": "footer_v4",
          "label": "Footer v4"
        },
        {
          "value": "footer_v5",
          "label": "Footer v5"
        },
        {
          "value": "footer_v6",
          "label": "Footer v6"
        },
        {
          "value": "footer_none",
          "label": "No Footer"
        }
      ],
      "default": "footer_v1"
    },
    {
      "type": "color",
      "id": "ft_home_bg_footer",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "ft_home_color_text",
      "label": "Texts, Icons Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Footer OtherPages"
    },
    {
      "type": "select",
      "id": "select_fts_all",
      "label": "Select Footer Style for All page (unless Homepage)",
      "options": [
        {
          "value": "footer_ver1",
          "label": "Footer v1"
        },
        {
          "value": "footer_ver2",
          "label": "Footer v2"
        },
        {
          "value": "footer_ver3",
          "label": "Footer v3"
        },
        {
          "value": "footer_ver4",
          "label": "Footer v4"
        },
        {
          "value": "footer_ver5",
          "label": "Footer v5"
        },
        {
          "value": "footer_ver6",
          "label": "Footer v6"
        }
      ],
      "default": "footer_ver1"
    },
    {
      "type": "color",
      "id": "ft_other_bg_footer",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "ft_other_color_text",
      "label": "Texts, Icons Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Footer v4 Settings"
    },
    {
      "type": "text",
      "id": "titlecolum_fv4_1",
      "label": "Heading Column 1",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_fv4_1",
      "label": "Select Menu column 1"
    },
    {
      "type": "text",
      "id": "titlecolum_fv4_2",
      "label": "Heading Column 2",
      "default": "Policies"
    },
    {
      "type": "link_list",
      "id": "menu_fv4_2",
      "label": "Select Menu column 2"
    },
    {
      "type": "text",
      "id": "titlecolum_fv4_3",
      "label": "Heading Column 3",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "menu_fv4_3",
      "label": "Select Menu column 3"
    },
    {
      "type": "text",
      "id": "titlecolum_fv4_4",
      "label": "Heading Column 4",
      "default": "Follow Us"
    },
    {
      "type": "text",
      "id": "fv4_phone",
      "label": "Phone Number",
      "default": "+91 88476 21677"
    },
    {
      "type": "text",
      "id": "fv4_email",
      "label": "Email Address",
      "default": "hello@cobblerandco.com"
    },
    {
      "type": "text",
      "id": "fv4_address",
      "label": "Store Address",
      "default": "Chandigarh, India"
    },
    {
      "type": "textarea",
      "id": "content_colum_fv4_5",
      "label": "Content Social Column 4",
      "default": "<ul class=\"list-inline list-unstyled mb-0\">\n  <li class=\"list-inline-item\">\n    <a href=\"https://www.instagram.com/cobblernco\" title=\"Instagram\" class=\"social-item\" target=\"_blank\">\n      <i class=\"fa fa-instagram\"></i>\n    </a>\n  </li>\n</ul>"
    },
    {
      "type": "checkbox",
      "id": "enable_fv4_bottom",
      "label": "Enable Footer Bottom",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "fv4_main_logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "fv4_main_logo_maxwidth",
      "min": 30,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Logo display width",
      "default": 160
    },
    {
      "type": "textarea",
      "id": "logo_svg4",
      "label": "SVG logo"
    },
    {
      "type": "image_picker",
      "id": "fv4_bottom_payment_img",
      "label": "Payment image"
    },
    {
      "type": "textarea",
      "id": "fv4_bottom_copyright",
      "label": "Copyright content",
      "default": "<div class=\"text-copyright mb-0\">\n  © 2026 Cobbler & Co. All Rights Reserved.\n</div>"
    }
  ]
}
{% endschema %}